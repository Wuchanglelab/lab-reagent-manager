# Flask / runtime
FLASK_DEBUG=0
DATA_DIR=./data
HOST=127.0.0.1
PORT=8080

# Database
# Leave DATABASE_URL empty to use local SQLite at $DATA_DIR/lab_reagents.db.
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=

# Admin controls
# Required for protected destructive actions such as reagent deletion and reservation cancellation.
LAB_ADMIN_PASSWORD=change-this-admin-password
LAB_ADMIN_NAME="Administrator"

# Public app URL used in notification emails.
APP_BASE_URL=http://127.0.0.1:8080

# OpenAI-compatible AI features
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4.1-mini

# Backward-compatible AI provider variables recognized by app.py.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
TEAMPLUS_API_KEY=
BASE_URL=
MODEL=

# SMTP notifications for purchase approvals
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Lab Reagent Manager"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
LAB_APPROVER_EMAILS=

# Vercel Blob uploads
# When unset, uploads are stored locally under $DATA_DIR/uploads.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=public
